  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#627987",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["comment.block.documentation", "comment.line.documentation"],
      "settings": {
        "foreground": "#8A8477",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#7C9B96"
      }
    },
    {
      "scope": ["string.regexp", "string.quoted.regexp"],
      "settings": {
        "foreground": "#8FC4C4"
      }
    },
    {
      "scope": ["constant.character.escape", "constant.other.character-class.escape"],
      "settings": {
        "foreground": "#B6D7BA"
      }
    },
    {
      "scope": ["string.other.link"],
      "settings": {
        "foreground": "#8FC4C4"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#E3A25A"
      }
    },
    {
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#E7894C"
      }
    },
    {
      "scope": ["constant.other.symbol"],
      "settings": {
        "foreground": "#E3A25A"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D9634F"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#D9634F"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.language"],
      "settings": {
        "foreground": "#F2ECDD"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": {
        "foreground": "#6A9FCC"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.type", "support.class"],
      "settings": {
        "foreground": "#E3C888"
      }
    },
    {
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "foreground": "#E3C888"
      }
    },
    {
      "scope": ["entity.name.constructor"],
      "settings": {
        "foreground": "#6A9FCC"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#E3A25A"
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#D9634F"
      }
    },
    {
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#B8AFA0"
      }
    },
    {
